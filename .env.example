# Supabase project (Settings -> API). Both values are safe to expose to the browser;
# security comes from the row-level-security policies in supabase/migrations.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# SERVER-ONLY (set in Vercel project settings; never prefix with VITE_):
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# GITHUB_WEBHOOK_SECRET=
